# ============================================================
# GUIA GNRE - CONFIGURACOES GERAIS
# ============================================================
APP_NAME=Sistema GNRE
APP_VERSION=2.0.0
ENVIRONMENT=development


# ============================================================
# BANCO DE DADOS
# ============================================================
# PRODUCAO - usar somente no ambiente operacional
# DATABASE_PATH=data/db.sqlite3

# HOMOLOGACAO / TESTES
# O banco precisa existir antes de iniciar o backend.
DATABASE_PATH=data/db_homologacao.sqlite3

MEDIA_ROOT=media


# ============================================================
# FRONTEND / CORS
# ============================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

FRONTEND_PUBLIC_URL=http://127.0.0.1:5173

AUTH_COOKIE_SECURE=false


# ============================================================
# GNRE - PRODUCAO
# ============================================================
# GNRE_WEBSERVICE_URL=https://www.gnre.pe.gov.br/gnreWS/services/GnreLoteRecepcao
# GNRE_RESULTADO_WEBSERVICE_URL=https://www.gnre.pe.gov.br/gnreWS/services/GnreResultadoLote


# ============================================================
# GNRE - HOMOLOGACAO
# ============================================================
# ATENCAO:
# Em outubro/2026, os testes identificaram erro SSL/TLS
# de incompatibilidade entre hostname e certificado HTTPS.
# A integracao completa ainda nao foi homologada.

GNRE_WEBSERVICE_URL=https://www.testegnre.pe.gov.br/gnreWS/services/GnreLoteRecepcao
GNRE_RESULTADO_WEBSERVICE_URL=https://www.testegnre.pe.gov.br/gnreWS/services/GnreResultadoLote


# ============================================================
# SEGURANCA - CERTIFICADOS DIGITAIS
# ============================================================
# Gerar uma chave Fernet valida para o .env real.
# Nao publicar a chave verdadeira no repositorio.

CERTIFICATE_ENCRYPTION_KEY=

# Chave administrativa da API.
# Definir um segredo forte e exclusivo no .env real.

GNRE_ADMIN_API_KEY=


# ============================================================
# CONTROLE DE EMISSAO GNRE
# ============================================================
# SEGURANCA:
# O envio permanece desabilitado por padrao.
#
# Ativar somente apos validar URLs, banco, certificados,
# ambiente GNRE e autorizacao para emissao.

GNRE_ENVIOS_HABILITADOS=false


# ============================================================
# SMTP - RECUPERACAO DE SENHA
# ============================================================
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USER=seuemail@dominio.com.br
SMTP_PASSWORD=